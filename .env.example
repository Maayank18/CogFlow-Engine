# ==============================================================================
# CogFlow Environment Configuration Template
# ==============================================================================

# Server Network & Mode
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:5173

# Database Connection (MongoDB)
# Local instance or MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/cogflow
MONGODB_USE_IN_MEMORY_FALLBACK=true

# Security & Authentication
JWT_SECRET=cogflow_development_secret_key_change_in_production_32chars!
JWT_EXPIRES_IN=7d
COOKIE_SECRET=cogflow_secure_cookie_secret_dev_environment_32chars!

# LLM Providers Configuration
# Default provider: 'ollama' | 'groq' | 'openrouter' | 'mock'
DEFAULT_LLM_PROVIDER=ollama
ENABLE_CLOUD_FALLBACK=true

# Local Ollama Configuration
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_TIMEOUT_MS=60000

# Cloud Provider: Groq (Optional fallback)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Cloud Provider: OpenRouter (Optional fallback)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Cognitive Inference Engine
# 'mock' for development simulation | 'external' for external adapter
COGNITIVE_PROVIDER=mock
ENABLE_COGNITIVE_SIMULATION=true
COGNITIVE_SUSTAINED_THRESHOLD_SECONDS=30
COGNITIVE_CONFIDENCE_THRESHOLD=0.60

# File Upload Configuration
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=./uploads

# Client-side envs (Vite uses VITE_ prefix)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=CogFlow
VITE_ENABLE_COGNITIVE_SIMULATION=true

